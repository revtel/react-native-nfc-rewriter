# Copy this file to .testflight.env and fill in the values from App Store Connect.
# Use an Admin team API key so Xcode can use cloud-managed distribution signing.
# Keep the .p8 private key outside Git, or under the ignored .testflight-secrets directory.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Optional overrides. The script reads the version from the Xcode project and
# generates a UTC timestamp build number when these are omitted.
# TESTFLIGHT_VERSION=0.5.1
# TESTFLIGHT_BUILD_NUMBER=2026091001
