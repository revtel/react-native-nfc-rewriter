{
  "name": "react-native-nfc-rewriter",
  "version": "0.6.0",
  "private": true,
  "revAppInd": "com.revteltech.nfcopenrewriter",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "testflight": "./tools/testflight.sh",
    "android:clean": "cd android && ./gradlew clean",
    "android:bundle": "cd android && ./gradlew bundleRelease && cd .. && open android/app/build/outputs/bundle/release",
    "android:assemble": "cd android && ./gradlew assembleRelease && cd .. && open android/app/build/outputs/apk/release",
    "android:elf_check": "./scripts/check_elf_alignment.sh ./android/app/build/outputs/apk/release/app-release.apk | grep -E 'x86_64.*UNALIGNED'",
    "android:start": "adb shell am start -n com.washow.nfcopenrewriter/.MainActivity"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.3.28",
    "clone-deep": "^4.0.1",
    "eventemitter3": "^4.0.0",
    "i18next": "26.4.2",
    "query-string": "^7.0.1",
    "react": "19.2.3",
    "react-i18next": "17.0.15",
    "react-native": "0.86.3",
    "react-native-device-info": "^14.0.2",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "2.33.0",
    "react-native-localize": "3.7.2",
    "react-native-nfc-manager": "4.1.0",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "5.5.2",
    "react-native-screens": "4.28.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-worklets": "0.13.0",
    "reconnect.js": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "dotenv": "^10.0.0",
    "eslint": "^8.19.0",
    "execa": "^5.0.1",
    "husky": "^5.0.9",
    "jest": "^29.6.3",
    "lint-staged": "^10.5.4",
    "ora": "^5.4.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
